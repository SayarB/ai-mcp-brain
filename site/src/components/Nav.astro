---
const path = Astro.url.pathname;
const docsActive = path.startsWith("/docs");
---

<header class="relative z-20 border-b border-line/70 bg-paper/80 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4 md:px-8">
    <a href="/" class="font-display text-xl font-semibold tracking-tight text-ink no-underline md:text-2xl">
      Hem Vault
    </a>
    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Primary">
      <a
        href="/docs"
        class:list={[
          "inline-flex min-h-11 items-center px-3 text-sm font-medium no-underline transition-colors",
          docsActive ? "text-accent" : "text-ink/80 hover:text-accent",
        ]}
      >
        Docs
      </a>
      <a
        href="https://github.com/SayarB/ai-mcp-brain"
        class="inline-flex min-h-11 items-center px-3 text-sm font-medium text-ink/80 no-underline transition-colors hover:text-accent"
        rel="noopener noreferrer"
        target="_blank"
      >
        GitHub
      </a>
      <a href="/docs/guides/getting-started" class="btn-primary ml-1 hidden sm:inline-flex">
        Get started
      </a>
    </nav>
  </div>
</header>
