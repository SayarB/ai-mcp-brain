---
/**
 * Full-bleed vault illustration — product metaphor for Hem Vault.
 * Workshop archive: shelves, folios, a bridge line to an agent pane.
 */
---

<svg
  class="h-full w-full"
  viewBox="0 0 1440 900"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="wash" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#e8e2d4" />
      <stop offset="55%" stop-color="#f3efe6" />
      <stop offset="100%" stop-color="#dfe8e4" />
    </linearGradient>
    <linearGradient id="shelfGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#d4cdc0" />
      <stop offset="100%" stop-color="#c4bba8" />
    </linearGradient>
    <linearGradient id="folio" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f7f4ec" />
      <stop offset="100%" stop-color="#ebe4d4" />
    </linearGradient>
    <pattern id="grain" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="0.6" fill="#1a1f1c" opacity="0.04" />
      <circle cx="4" cy="3" r="0.5" fill="#2f6f68" opacity="0.03" />
    </pattern>
  </defs>

  <rect width="1440" height="900" fill="url(#wash)" />
  <rect width="1440" height="900" fill="url(#grain)" />

  <!-- Room depth -->
  <path d="M0 720 H1440 V900 H0 Z" fill="#ddd5c4" opacity="0.55" />
  <path d="M0 0 H420 L380 900 H0 Z" fill="#e4ddd0" opacity="0.45" />

  <!-- Vault wall -->
  <g class="vault-wall">
    <rect x="480" y="120" width="520" height="620" rx="4" fill="#cfc6b5" stroke="#1a1f1c" stroke-opacity="0.18" stroke-width="2" />
    <rect x="500" y="148" width="480" height="560" fill="#b9b09e" opacity="0.35" />

    <!-- Shelves -->
    <g stroke="#1a1f1c" stroke-opacity="0.2" stroke-width="2">
      <line x1="510" y1="260" x2="970" y2="260" />
      <line x1="510" y1="390" x2="970" y2="390" />
      <line x1="510" y1="520" x2="970" y2="520" />
      <line x1="510" y1="650" x2="970" y2="650" />
    </g>

    <!-- Folios row 1 -->
    <g class="folios">
      <rect x="530" y="178" width="70" height="70" rx="2" fill="url(#folio)" stroke="#2f6f68" stroke-opacity="0.45" />
      <rect x="620" y="170" width="78" height="78" rx="2" fill="url(#folio)" stroke="#1a1f1c" stroke-opacity="0.2" />
      <rect x="720" y="182" width="64" height="66" rx="2" fill="url(#folio)" stroke="#2f6f68" stroke-opacity="0.35" />
      <rect x="810" y="174" width="72" height="74" rx="2" fill="url(#folio)" stroke="#1a1f1c" stroke-opacity="0.18" />
      <rect x="900" y="186" width="58" height="62" rx="2" fill="url(#folio)" stroke="#2f6f68" stroke-opacity="0.4" />
      <!-- lines on notes -->
      <path d="M542 198 H586 M542 210 H578 M542 222 H582" stroke="#5c635e" stroke-opacity="0.45" stroke-width="1.5" />
      <path d="M636 190 H680 M636 202 H674 M636 214 H678" stroke="#5c635e" stroke-opacity="0.4" stroke-width="1.5" />
    </g>

    <!-- Folios row 2 -->
    <g>
      <rect x="545" y="292" width="88" height="82" rx="2" fill="url(#folio)" stroke="#1a1f1c" stroke-opacity="0.2" />
      <rect x="655" y="300" width="70" height="74" rx="2" fill="url(#folio)" stroke="#2f6f68" stroke-opacity="0.5" />
      <rect x="750" y="288" width="96" height="86" rx="2" fill="url(#folio)" stroke="#1a1f1c" stroke-opacity="0.18" />
      <rect x="870" y="304" width="74" height="70" rx="2" fill="url(#folio)" stroke="#2f6f68" stroke-opacity="0.35" />
      <path d="M562 318 H610 M562 332 H602 M562 346 H614" stroke="#5c635e" stroke-opacity="0.4" stroke-width="1.5" />
      <path d="M670 322 H708 M670 336 H702" stroke="#2f6f68" stroke-opacity="0.55" stroke-width="1.5" />
    </g>

    <!-- Folios row 3 — project packs -->
    <g>
      <rect x="535" y="430" width="120" height="74" rx="2" fill="#f0ebe0" stroke="#2f6f68" stroke-width="1.75" />
      <text x="555" y="472" fill="#2f6f68" font-family="Figtree, sans-serif" font-size="14" font-weight="600">projects/</text>
      <rect x="680" y="424" width="100" height="80" rx="2" fill="url(#folio)" stroke="#1a1f1c" stroke-opacity="0.2" />
      <rect x="810" y="436" width="130" height="68" rx="2" fill="#f0ebe0" stroke="#1a1f1c" stroke-opacity="0.2" />
      <text x="828" y="476" fill="#5c635e" font-family="Figtree, sans-serif" font-size="13" font-weight="500">actions/</text>
    </g>

    <!-- Folios row 4 -->
    <g>
      <rect x="550" y="560" width="80" height="72" rx="2" fill="url(#folio)" stroke="#1a1f1c" stroke-opacity="0.18" />
      <rect x="655" y="552" width="92" height="80" rx="2" fill="url(#folio)" stroke="#2f6f68" stroke-opacity="0.4" />
      <rect x="770" y="566" width="76" height="66" rx="2" fill="url(#folio)" stroke="#1a1f1c" stroke-opacity="0.2" />
      <rect x="870" y="558" width="84" height="74" rx="2" fill="url(#folio)" stroke="#2f6f68" stroke-opacity="0.35" />
    </g>
  </g>

  <!-- Bridge to agent -->
  <g class="bridge">
    <path
      d="M1000 380 C1120 360, 1180 320, 1260 300"
      stroke="#2f6f68"
      stroke-width="2.5"
      stroke-dasharray="6 8"
      fill="none"
      opacity="0.75"
    />
    <circle cx="1000" cy="380" r="5" fill="#2f6f68" />
    <circle cx="1260" cy="300" r="5" fill="#2f6f68" />
  </g>

  <!-- Agent pane -->
  <g class="agent-pane">
    <rect x="1180" y="220" width="200" height="260" rx="6" fill="#1a1f1c" />
    <rect x="1194" y="238" width="172" height="14" rx="2" fill="#2f6f68" opacity="0.85" />
    <rect x="1194" y="268" width="140" height="8" rx="1" fill="#f3efe6" opacity="0.35" />
    <rect x="1194" y="288" width="160" height="8" rx="1" fill="#f3efe6" opacity="0.28" />
    <rect x="1194" y="308" width="120" height="8" rx="1" fill="#f3efe6" opacity="0.22" />
    <rect x="1194" y="340" width="172" height="100" rx="3" fill="#243029" />
    <path d="M1210 370 H1340 M1210 390 H1310 M1210 410 H1330" stroke="#2f6f68" stroke-opacity="0.55" stroke-width="2" />
  </g>

  <!-- Floor shadow -->
  <ellipse cx="740" cy="780" rx="280" ry="28" fill="#1a1f1c" opacity="0.08" />
</svg>

<style>
  .folios rect,
  .agent-pane,
  .bridge path {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bridge path {
      stroke-dashoffset: 48;
      animation: dash 8s linear infinite;
    }
    .agent-pane {
      animation: rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
