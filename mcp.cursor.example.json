{
  "mcpServers": {
    "ai-mcp-brain": {
      "command": "<absolute-path-to-bun-OR-node>",
      "args": [
        "<if-node: absolute-path-to-repo/node_modules/tsx/dist/cli.mjs>",
        "<absolute-path-to-repo>/src/mcp/server.ts"
      ],
      "cwd": "<absolute-path-to-repo>",
      "env": {
        "BRAIN_VAULT": "<absolute-vault-path>"
      }
    }
  }
}
